# Huella Digital - Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# SUPABASE (Required)
# ===========================================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# INNGEST (Required for background jobs)
# ===========================================
# Get from https://app.inngest.com
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ===========================================
# EXTERNAL APIs (Required for search functionality)
# ===========================================
# Google Custom Search API
# Get from https://developers.google.com/custom-search/v1/introduction
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id

# Have I Been Pwned API
# Free for basic use, see https://haveibeenpwned.com/API/v3
HIBP_API_KEY=your-hibp-api-key

# ===========================================
# EMAIL (Required for GDPR notifications)
# ===========================================
# Resend (https://resend.com)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@huelladigital.app

# ===========================================
# OPTIONAL
# ===========================================
# Site URL (for absolute URLs in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Error tracking (optional)
SENTRY_DSN=
